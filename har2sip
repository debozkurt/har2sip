#!/usr/bin/env python3
"""Convert SIP-over-WebSocket frames in a Chrome HAR into a pcap.

Chrome stores WSS frames in each HAR entry's `_webSocketMessages`, a DevTools
extension to the HAR 1.2 spec. SIP tools cannot read HAR, so each frame is
re-wrapped as Ethernet/IPv4/UDP on the SIP port, which Wireshark and sngrep
both dissect natively.

The SIP bytes, their direction and their timestamps are real. The endpoint
addresses are synthetic: a HAR never records the browser's own IP.
"""

import argparse
import json
import os
import re
import struct
import subprocess
import sys
from collections import Counter
from datetime import datetime, timezone

IPV4 = r"\d{1,3}(?:\.\d{1,3}){3}"
WIRESHARK_MAC = "/Applications/Wireshark.app/Contents/MacOS"


def utc(ts):
    """Epoch seconds -> ISO 8601 UTC with milliseconds."""
    stamp = datetime.fromtimestamp(ts, timezone.utc).isoformat(timespec="milliseconds")
    return stamp.replace("+00:00", "Z")


def is_sip(data):
    if not data:
        return False
    first = data.split("\r\n", 1)[0].split("\n", 1)[0]
    return data.startswith("SIP/2.0") or first.endswith(" SIP/2.0")


def header_values(msg, name):
    """Yield each occurrence of a header, tolerating LF-only line endings."""
    for line in re.split(r"\r?\n", msg):
        if not line.strip():
            break
        if line.lower().startswith(name.lower() + ":"):
            yield line.split(":", 1)[1].strip()


def find_peer(frames):
    """Guess the far-end IP: the address seen most often in Via headers."""
    seen = Counter()
    for msg in frames:
        for via in header_values(msg, "Via"):
            seen.update(re.findall(IPV4, via))
        for contact in header_values(msg, "Contact"):
            seen.update(re.findall(IPV4, contact))
    return seen.most_common(1)[0][0] if seen else None


def checksum(data):
    if len(data) % 2:
        data += b"\x00"
    total = 0
    for i in range(0, len(data), 2):
        total += (data[i] << 8) + data[i + 1]
    total = (total >> 16) + (total & 0xFFFF)
    total += total >> 16
    return ~total & 0xFFFF


def packet(src_ip, dst_ip, port, payload):
    udp_len = 8 + len(payload)
    udp = struct.pack("!HHHH", port, port, udp_len, 0) + payload
    ip = struct.pack(
        "!BBHHHBBH4s4s",
        0x45, 0, 20 + udp_len, 0, 0x4000, 64, 17, 0,
        bytes(int(o) for o in src_ip.split(".")),
        bytes(int(o) for o in dst_ip.split(".")),
    )
    ip = ip[:10] + struct.pack("!H", checksum(ip)) + ip[12:]
    eth = b"\x02\x00\x00\x00\x00\x01\x02\x00\x00\x00\x00\x02\x08\x00"
    return eth + ip + udp


def collect(har_path, ua_base, default_peer):
    """Return SIP frames as (timestamp, src, dst, payload) tuples."""
    with open(har_path) as fh:
        har = json.load(fh)

    out = []
    conn = 0
    for entry in har.get("log", {}).get("entries", []):
        frames = [m for m in entry.get("_webSocketMessages", []) if is_sip(m.get("data"))]
        if not frames:
            continue
        conn += 1
        ua_ip = "%s.%d" % (ua_base.rsplit(".", 1)[0], int(ua_base.rsplit(".", 1)[1]) + conn - 1)
        peer = default_peer or find_peer([m["data"] for m in frames]) or "10.0.0.254"
        if peer == ua_ip:
            peer = "10.0.0.254"
        url = entry.get("request", {}).get("url", "?").split("?")[0]
        print("  %-2d %-52s %s <-> %s  (%d frames)" % (conn, url[:52], ua_ip, peer, len(frames)))
        for m in frames:
            src, dst = (ua_ip, peer) if m.get("type") == "send" else (peer, ua_ip)
            out.append((m["time"], src, dst, m["data"]))
    out.sort(key=lambda r: r[0])
    return out


def summarise(frames):
    calls = Counter()
    for _, _, _, data in frames:
        for cid in header_values(data, "Call-ID"):
            calls[cid] += 1
            break
        else:
            for cid in header_values(data, "Call-Id"):
                calls[cid] += 1
                break
    return calls


def convert(har_path, args):
    stem = os.path.splitext(os.path.basename(har_path))[0]
    outdir = args.outdir or os.path.dirname(os.path.abspath(har_path))
    pcap_path = os.path.join(outdir, stem + ".sip.pcap")
    txt_path = os.path.join(outdir, stem + ".sip.txt")

    print("%s" % har_path)
    frames = collect(har_path, args.ua_ip, args.peer_ip)
    if not frames:
        print("  no SIP frames found\n", file=sys.stderr)
        return None

    with open(pcap_path, "wb") as pcap:
        pcap.write(struct.pack("!IHHiIII", 0xA1B2C3D4, 2, 4, 0, 0, 262144, 1))
        for ts, src, dst, data in frames:
            pkt = packet(src, dst, args.port, data.encode("utf-8", "replace"))
            pcap.write(struct.pack("!IIII", int(ts), int(round((ts % 1) * 1e6)), len(pkt), len(pkt)))
            pcap.write(pkt)

    if not args.no_text:
        with open(txt_path, "w") as txt:
            for ts, src, dst, data in frames:
                txt.write("===== %s %s -> %s =====\n%s\n" % (utc(ts), src, dst, data))

    calls = summarise(frames)
    span = frames[-1][0] - frames[0][0]
    print("  %d SIP frames, %d Call-ID(s), %.1fs span" % (len(frames), len(calls), span))
    for cid, n in calls.most_common():
        print("    %-58s %d msgs" % (cid[:58], n))
    print("  -> %s" % pcap_path)
    if not args.no_text:
        print("  -> %s" % txt_path)
    print()
    return pcap_path


def launch(tool, pcaps):
    if tool == "sngrep":
        os.execvp("sngrep", ["sngrep", "-I", pcaps[0]])
    if tool == "wireshark":
        exe = "wireshark"
        if os.path.isdir(WIRESHARK_MAC):
            exe = os.path.join(WIRESHARK_MAC, "Wireshark")
        subprocess.Popen([exe] + pcaps,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    p = argparse.ArgumentParser(
        description="Extract SIP-over-WebSocket frames from Chrome HAR files into pcap.",
        epilog="Endpoint IPs are synthetic; SIP bytes, direction and timing are real.")
    p.add_argument("har", nargs="+", help="one or more .har files")
    p.add_argument("-o", "--outdir", help="output directory (default: alongside each input)")
    p.add_argument("-p", "--port", type=int, default=5060,
                   help="UDP port to frame SIP on (default 5060)")
    p.add_argument("--ua-ip", default="10.0.0.1",
                   help="synthetic client IP; incremented per WebSocket (default 10.0.0.1)")
    p.add_argument("--peer-ip", help="override the detected server IP")
    p.add_argument("--no-text", action="store_true", help="skip the .sip.txt dump")
    p.add_argument("--open", choices=["sngrep", "wireshark"],
                   help="open the result when done")
    args = p.parse_args()

    pcaps = [q for q in (convert(h, args) for h in args.har) if q]
    if not pcaps:
        sys.exit("no SIP found in any input")
    if args.open:
        launch(args.open, pcaps)


if __name__ == "__main__":
    main()
